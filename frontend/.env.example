# AstroTrack (AAHMS) Frontend Environment Configuration (Placeholders Only)
# Copy this file to .env.local to configure integration with the FastAPI backend.

# Team backend URL as defined in docs/frontend_guide.md:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to true to route requests to the FastAPI backend instead of the local demo repository
NEXT_PUBLIC_USE_API=false

# Proposed API v1 prefix (to be confirmed with backend team)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
