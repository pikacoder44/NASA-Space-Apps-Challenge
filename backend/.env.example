# Database credentials & URL
POSTGRES_USER=astro_user
POSTGRES_PASSWORD=your_local_secure_password
POSTGRES_DB=astrotrack_db
DATABASE_URL=postgresql+psycopg2://astro_user:your_local_secure_password@db:5432/astrotrack_db

# Security & Secrets
SECRET_KEY=insecure_dev_secret_key_for_hackathon_only

# Frontend integration URL
FRONTEND_URL=http://localhost:3000

# Auth enforcement (false for hackathon demo mode, true for production)
AUTH_REQUIRED=false
