# Copy to backend/.env for local development. Never commit the real .env file.
# (docker-compose sets its own values; see docker-compose.yml.)

# Database: SQLite by default, works offline with no setup.
DATABASE_URL=sqlite:///./aahms.db
# PostgreSQL example (docker-compose uses host "db"):
# DATABASE_URL=postgresql+psycopg2://astro_user:your_local_secure_password@localhost:5432/astrotrack_db
# Neon (Vercel deployment): paste the connection string from the Neon dashboard, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# JWT signing key. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random key is generated at startup (logins reset on restart). Set it when deployed.
# SECRET_KEY=

# Allowed frontend origin(s), comma-separated. Localhost (any port) and *.vercel.app are always allowed.
FRONTEND_URL=http://localhost:3000

# Login token (JWT) lifetime in minutes. Default 30.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# false = requests without a token use the demo astronaut (id 1). true = token required.
AUTH_REQUIRED=false

# Last simulated mission day loaded by the seed on startup (that day = today).
SEED_MISSION_DAY=90

# Password of the shared demo astronaut (crew@astrotrack.space).
# DEMO_PASSWORD=
