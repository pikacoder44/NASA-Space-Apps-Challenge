# AstroTrack (AAHMS) Frontend Environment Configuration
# Copy this file to .env.local for local development.

# In Vercel multi-service deployment:
# - BACKEND_URL is automatically injected into server functions by the service binding in vercel.json.
# - Client-side requests route through Vercel's /api/(.*) rewrites on the same domain (relative URL).
#
# For standalone local development without `vercel dev`:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to true to route requests to the FastAPI backend instead of the local demo repository
NEXT_PUBLIC_USE_API=true
